{
  "name": "about",
  "version": "3.0.0",
  "description": "Personal website",
  "author": "Simon Robin",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/simrobin/about.git"
  },
  "homepage": "https://simrobin.fr",
  "packageManager": "pnpm@11.16.0",
  "engines": {
    "node": "=24",
    "pnpm": "=11"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "panda codegen && astro build",
    "preview": "astro preview",
    "lint": "biome check --fix src/",
    "lint:file": "biome check --fix",
    "format": "biome format --write src/",
    "test": "playwright test",
    "test:ci": "playwright test",
    "test:update": "playwright test --update-snapshots",
    "typecheck": "astro check",
    "prepare": "panda codegen --clean"
  },
  "dependencies": {
    "@fontsource-variable/montserrat": "^5.3.0",
    "astro": "^7.4.2",
    "astro-icon": "^1.2.0",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@biomejs/biome": "2.6.2",
    "@iconify-json/lucide": "^1.2.147",
    "@iconify-json/simple-icons": "^1.2.100",
    "@pandacss/dev": "^2.4.0",
    "@pandacss/postcss": "^2.4.0",
    "@pandacss/preset-base": "^2.4.0",
    "@playwright/test": "1.64.1",
    "typescript": "6.0.3"
  },
